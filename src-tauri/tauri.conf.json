{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PandaMatch",
  "version": "1.0.0",
  "identifier": "com.pandastudios.pandamatch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PandaMatch",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExOTFENjZFN0NBQUY2MDMKUldRRDlxcDhidGFSb1FvcDFEQmNHd3ZjUXBKc0h2T0c2OXJ6OGczZFdVK2Nzdi9BUmtYRlVkczUK",
      "endpoints": [
        "https://github.com/panda-test-lab/PandaMatch/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
